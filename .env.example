# Test Configuration for LLM-Enhanced BotGenerator

# Telegram Bot Token (BotGenerator)
BOT_TOKEN=your_botgenerator_token_here

# LLM Configuration
# Provider: gemini, openai, or claude
LLM_PROVIDER=gemini

# API Key for chosen provider
LLM_API_KEY=your_llm_api_key_here

# Model name (optional - uses default if not specified)
# Gemini: gemini-pro, gemini-1.5-pro
# OpenAI: gpt-4-turbo-preview, gpt-3.5-turbo
# Claude: claude-3-opus-20240229, claude-3-sonnet-20240229
LLM_MODEL=gemini-pro
